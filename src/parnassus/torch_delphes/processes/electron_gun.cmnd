! electron_gun.cmnd
! Electron CALIBRATION sample: J/psi -> e e  +  Z -> e e resonance gun for the CMS
! full-simulation pseudodata generator (parnassus.torch_delphes.generate_pseudodata
! --process electrongun).
! ---- Gun definition (consumed by the driver, stripped before Pythia) ----
Gun:on = on
Gun:ids = 443 23                    ! J/psi and Z, one of them per event (uniform)
Gun:nPerEvent = 1
Gun:pTmin = 1. 1.                   ! GeV, per id (J/psi, Z)
Gun:pTmax = 20. 500.                ! GeV, per id -- J/psi kept soft (track-dominated daughters)
Gun:pTpower = 1.5                   ! dN/dpT ~ pT^-1.5 (falling)
Gun:etaMin = -2.5
Gun:etaMax = 2.5

! ---- Decays: force the e+ e- channels (ordinary Pythia settings) ----
443:onMode = off
443:onIfMatch = 11 -11
23:onMode = off
23:onIfAny = 11
23:mMin = 70.                       ! Z line shape window (kills the Breit-Wigner tail)
23:mMax = 110.

! ---- Pythia: no hard process, we fill the event record ourselves ----
ProcessLevel:all = off
Beams:idA = 2212
Beams:idB = 2212
Beams:eCM = 13000.                  ! only sets the bookkeeping beam particles

! ---- Suppress per-event and initialization printout ----
Next:numberShowInfo = 0
Next:numberShowProcess = 0
Next:numberShowEvent = 0
Init:showProcesses = off
Init:showMultipartonInteractions = off
Init:showChangedSettings = off
Init:showChangedParticleData = off
Stat:showProcessLevel = off
Stat:showPartonLevel = off
Stat:showErrors = off
